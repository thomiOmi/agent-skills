{
  "$schema": "https://opencode.ai/tui.json",

  // Global TUI config template for agent-skills.
  // Deployed to ~/.config/opencode/ and merged with user's existing config.
  // Only non-default values are included. Defaults: https://opencode.ai/docs/tui/#options

  "attention": {
    "enabled": true
    // TODO: customize attention sounds. See https://opencode.ai/docs/tui/#attention
    // Example:
    //   "sounds": {
    //     "error": "./sounds/error.mp3",
    //     "done": "./sounds/success.wav"
    //   }
  }
}
