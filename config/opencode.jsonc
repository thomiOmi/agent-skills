{
  "$schema": "https://opencode.ai/config.json",

  // Global config template for agent-skills.
  // Installed to ~/.config/opencode/ and merged with the existing config.

  "default_agent": "plan",

  "experimental": {
    "subagent_depth": 2
  },

  "instructions": [
    "AGENTS.md"
  ],

  "formatter": true,

  "lsp": true,

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      ".turbo/**",
      ".cache/**",
      ".gradle/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      ".tox/**",
      "Pods/**",
      ".env.local",
      ".env.*.local"
    ]
  }

  // Skill loading permissions (wildcard patterns). Uncomment and adapt.
  // "permissions": [
  //   { "action": "skill", "resource": "*", "effect": "allow" },
  //   { "action": "skill", "resource": "experimental-*", "effect": "ask" }
  // ],

  // MCP servers (optional). Their tools register as <server-name>_<tool>.
  // Uncomment and adapt.
  // "mcp": {
  //   "servers": {
  //     "context7": {
  //       "type": "remote",
  //       "url": "https://mcp.context7.com/mcp"
  //     },
  //     "my-local-server": {
  //       "type": "local",
  //       "command": ["bun", "x", "my-mcp-command"],
  //       "enabled": true
  //     }
  //   }
  // },
}
