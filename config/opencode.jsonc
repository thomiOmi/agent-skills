{
  "$schema": "https://opencode.ai/config.json",

  // Global config template for agent-skills.
  // Deployed to ~/.config/opencode/ and merged with user's existing config.

  "default_agent": "plan",

  "subagent_depth": 2,

  "instructions": [
    "AGENTS.md"
  ],

  "formatter": true,

  "lsp": true,

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      ".turbo/**",
      ".cache/**",
      ".gradle/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      ".tox/**",
      "Pods/**",
      ".env.local",
      ".env.*.local"
    ]
  }

  // Skill loading permissions (wildcard patterns). Uncomment and adapt.
  // "permission": {
  //   "skill": {
  //     "*": "allow",
  //     "experimental-*": "ask"
  //   }
  // },

  // MCP servers (optional). Tools register as <server-name>_*. Uncomment and adapt.
  // "mcp": {
  //   "context7": {
  //     "type": "remote",
  //     "url": "https://mcp.context7.com/mcp"
  //   },
  //   "my-local-server": {
  //     "type": "local",
  //     "command": ["bun", "x", "my-mcp-command"],
  //     "enabled": true
  //   }
  // },
}
