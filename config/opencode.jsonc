{
  "$schema": "https://opencode.ai/config.json",

  // Global config template for agent-skills.
  // Deployed to ~/.config/opencode/ and merged with user's existing config.

  "default_agent": "plan",

  "subagent_depth": 2,

  "formatter": true,

  "lsp": true,

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      ".turbo/**",
      ".cache/**",
      ".gradle/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      ".tox/**",
      "Pods/**",
      ".env.local",
      ".env.*.local"
    ]
  },

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "mcp": {
    // =========================================================================
    // REQUIRED - enabled by default, zero or minimal setup
    // =========================================================================

    "context7": {
      // Library/framework docs lookup.
      // Optional: set CONTEXT7_API_KEY env var for higher rate limits.
      // Docs: https://opencode.ai/docs/mcp-servers#context7
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },

    "gh_grep": {
      // Search GitHub code examples (grep.app). No auth needed.
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },

    "memory": {
      // Knowledge graph persistence (used by orchestrator checkpoint).
      // File stored relative to CWD (typically ~/.config/opencode/).
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "./memory.jsonl"
      }
    },

    "mermaid": {
      // Mermaid diagram generation (flowcharts, sequence, class diagrams, etc.).
      // Free, open-source, no auth needed.
      "type": "local",
      "command": ["npx", "-y", "mcp-mermaid"],
      "enabled": true
    },

    "sequential-thinking": {
      // Structured step-by-step reasoning with revision and branching.
      // Makes model reasoning explicit and auditable. No auth needed.
      // Optional: DISABLE_THOUGHT_LOGGING=true to suppress logging.
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },

    // =========================================================================
    // OPTIONAL - disabled by default, requires manual setup
    // =========================================================================

    "github": {
      // GitHub API tools (issues, PRs, repos, actions, etc.).
      // Heavy context usage - only enable when needed.
      //
      // How to enable:
      //   1. Set "enabled": true
      //   2. Create a GitHub PAT (scopes: repo, read:org)
      //   3. Set GITHUB_PAT_TOKEN env var
      //   4. Restart OpenCode
      //
      // Docs: https://github.com/github/github-mcp-server
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT_TOKEN}"
      }
    },

    "playwright": {
      // Browser automation (navigate, click, screenshot, etc.).
      // Useful for QA/testing or web scraping.
      //
      // How to enable:
      //   1. Set "enabled": true
      //   2. npx playwright install chromium
      //   3. Restart OpenCode
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },

    "drawio": {
      // draw.io diagram generation and editor integration.
      // Opens diagrams in the draw.io editor in your browser.
      // Supports XML, CSV, and Mermaid.js formats.
      //
      // How to enable:
      //   1. Set "enabled": true
      //   2. Restart OpenCode
      //
      // Optional: DRAWIO_BASE_URL for self-hosted instances.
      // Docs: https://github.com/jgraph/drawio-mcp
      "type": "local",
      "command": ["npx", "-y", "@drawio/mcp"],
      "enabled": false
    }
  }
}
