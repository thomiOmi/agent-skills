{
  "$schema": "https://opencode.ai/config.json",

  // Global config template for agent-skills.
  // Deployed to ~/.config/opencode/ and merged with user's existing config.

  "default_agent": "plan",

  "subagent_depth": 2,

  "formatter": true,

  "lsp": true,

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "target/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      ".turbo/**",
      ".cache/**",
      ".gradle/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      ".tox/**",
      "Pods/**",
      ".env.local",
      ".env.*.local"
    ]
  },

  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
