{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@thomiomi/agent-skills",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "bun@1.4.4",
  "description": "Agent Orchestra for OpenCode - primary agent with verification loop, specialized subagents, skills, and custom tools",
  "author": "thomiOmi",
  "license": "MIT",
  "homepage": "https://github.com/thomiOmi/agent-skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomiOmi/agent-skills.git"
  },
  "bugs": {
    "url": "https://github.com/thomiOmi/agent-skills/issues"
  },
  "keywords": [
    "agent-skills",
    "agents",
    "opencode",
    "orchestra",
    "orchestrator"
  ],
  "files": [
    "AGENTS.md",
    "agents",
    "commands",
    "config",
    "instructions",
    "plugin",
    "skills",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test tests/",
    "changelog": "changelogen --output CHANGELOG.md",
    "release": "changelogen --release",
    "setup": "bun run src/cli.ts install",
    "setup:symlink": "bun run src/cli.ts install --mode symlink",
    "setup:merge": "bun run src/cli.ts install --mode merge",
    "cli": "bun run src/cli.ts"
  },
  "trustedDependencies": [
    "simple-git-hooks"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "c12": "^4.0.0-beta.5",
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "scule": "^1.3.0",
    "std-env": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.3.14",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.8.0",
    "yaml": "^2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit $1",
    "pre-push": "bun run typecheck && bun run test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix"
    ],
    "*.{md,json,jsonc,json5}": [
      "eslint --fix"
    ]
  }
}
