{
  "name": "@thomiOmi/agent-skills",
  "version": "0.2.0",
  "description": "Agent Orchestra for OpenCode — primary agent with verification loop, specialized subagents, skills, and custom tools",
  "keywords": [
    "agent-skills",
    "agents",
    "opencode",
    "orchestra",
    "orchestrator"
  ],
  "homepage": "https://github.com/thomiOmi/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/thomiOmi/agent-skills/issues"
  },
  "license": "MIT",
  "author": "thomiOmi",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomiOmi/agent-skills.git"
  },
  "files": [
    "agents",
    "skills",
    "plugin",
    ".opencode/tools",
    ".opencode/agents",
    "AGENTS.md"
  ],
  "type": "module",
  "main": "./plugin/agent-skills.ts",
  "exports": {
    ".": {
      "import": "./plugin/agent-skills.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "concurrently \"bun run lint:ts\" \"bun run lint:md\"",
    "lint:ts": "oxlint",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .github",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.4",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14"
}
