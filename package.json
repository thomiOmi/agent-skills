{
  "name": "@thomiOmi/agent-skills",
  "version": "0.1.0",
  "description": "OpenCode plugin for agent-skills — cross-platform TypeScript installer for agent skills, MCP servers, and AGENTS.md configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "bin": {
    "agent-skills": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/agent-skills.d.ts",
      "import": "./dist/plugin/agent-skills.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "plugin",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test tests/",
    "test:coverage": "bun test --coverage tests/",
    "prepublishOnly": "npm run build",
    "version": "bun run src/scripts/version.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@opencode-ai/sdk": "^1.18.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "destr": "^2.0.5",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "unconfig": "^7.5.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.75.0",
    "oxfmt": "^0.60.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bun": "^1.3.14"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thomiOmi/agent-skills.git"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "agent-skills",
    "plugin",
    "ai",
    "agents",
    "cross-platform",
    "oxc"
  ],
  "author": "thomiOmi",
  "bugs": {
    "url": "https://github.com/thomiOmi/agent-skills/issues"
  },
  "homepage": "https://github.com/thomiOmi/agent-skills#readme",
  "packageManager": "bun@1.3.14"
}