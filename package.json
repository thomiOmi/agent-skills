{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@thomiOmi/agent-skills",
  "version": "0.2.0",
  "description": "Agent Orchestra for OpenCode - primary agent with verification loop, specialized subagents, skills, and custom tools",
  "keywords": [
    "agent-skills",
    "agents",
    "opencode",
    "orchestra",
    "orchestrator"
  ],
  "homepage": "https://github.com/thomiOmi/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/thomiOmi/agent-skills/issues"
  },
  "license": "MIT",
  "author": "thomiOmi",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomiOmi/agent-skills.git"
  },
  "files": [
    "agents",
    "skills",
    "tools",
    "plugin",
    "AGENTS.md"
  ],
  "type": "module",
  "main": "./plugin/agent-skills.ts",
  "exports": {
    ".": {
      "import": "./plugin/agent-skills.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "eslint . --fix",
    "fmt:check": "eslint .",
    "test": "bun test tests/",
    "deploy": "bun run src/cli.ts deploy",
    "sync": "bun run src/cli.ts sync",
    "symlink": "bun run src/cli.ts symlink"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,json,jsonc,md,yml,yaml}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14"
}
