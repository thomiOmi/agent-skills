{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@thomiomi/agent-skills",
  "version": "0.3.0",
  "description": "Agent Orchestra for OpenCode - primary agent with verification loop, specialized subagents, skills, and custom tools",
  "keywords": [
    "agent-skills",
    "agents",
    "opencode",
    "orchestra",
    "orchestrator"
  ],
  "homepage": "https://github.com/thomiOmi/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/thomiOmi/agent-skills/issues"
  },
  "license": "MIT",
  "author": "thomiOmi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomiOmi/agent-skills.git"
  },
  "files": [
    "agents",
    "skills",
    "tools",
    "plugin",
    "bin",
    "src",
    "AGENTS.md"
  ],
  "type": "module",
  "main": "./plugin/agent-skills.ts",
  "bin": {
    "agent-skills": "bin/agent-skills.mjs"
  },
  "exports": {
    ".": {
      "import": "./plugin/agent-skills.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "eslint . --fix",
    "fmt:check": "eslint .",
    "test": "bun test tests/",
    "changelog": "changelogen --output CHANGELOG.md",
    "release": "changelogen --release",
    "evals": "bun run scripts/evals/run-evals.ts",
    "setup": "bun run src/cli.ts install",
    "setup:symlink": "bun run src/cli.ts install --mode symlink",
    "setup:merge": "bun run src/cli.ts install --mode merge",
    "cli": "bun run src/cli.ts"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix"
    ],
    "*.{md,json,jsonc}": [
      "eslint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit $1",
    "pre-push": "bun run typecheck && bun run test"
  },
  "trustedDependencies": [
    "simple-git-hooks"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "c12": "^4.0.0-beta.5",
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "giget": "^3.3.1",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "scule": "^1.3.0",
    "std-env": "^4.2.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.14"
}
